{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "outDir": "dist", "rootDir": ".", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "noUncheckedIndexedAccess": false, "resolveJsonModule": true
  },
  "include": ["src", "scripts", "prisma/seed.ts", "vitest.config.ts"]
}
