generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Deletion rules: everything owned by a User cascades on account deletion.
// SafetyEvent/AuditLog keep no content and use SetNull on user so that
// aggregate safety/audit data survives without identifying the person.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  locale       String   @default("en") // en | bn | mixed
  timezone     String   @default("UTC")
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       UserProfile?
  consents      UserConsent[]
  sessions      TherapySession[]
  moods         MoodEntry[]
  journal       JournalEntry[]
  goals         TherapyGoal[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  usage         UsageRecord[]
  safetyEvents  SafetyEvent[]
  checkIns      CheckIn[]
  sleepEntries  SleepEntry[]
  routineLogs   RoutineLog[]
  kaizenGoals   KaizenGoal[]
  kaizenActions KaizenAction[]
  weeklySummaries WeeklySummary[]
  dailyActivity DailyActivity[]
  nudgeSettings NudgeSettings?
  nudgeLogs     NudgeLog[]
  gardenState   GardenState?
  memories      Memory[]
  trustedContacts TrustedContact[]
  safetyPlan    SafetyPlan?
  programs      ProgramEnrollment[]
  treatmentPlans TreatmentPlan[]
  homeworks     Homework[]
  themes        ThemeTracker[]
  sessionNotes  SessionNote[]
  schedule      SessionSchedule?
  qualitySamples QualityReviewSample[]
  topics        Topic[]
  assessments   Assessment[]
  sessionPrograms SessionProgram[]
  actionOffers  ActionOffer[]
}

// What a session is about (addiction, depression, ...). The preset kind and any custom label live in one
// encrypted JSON blob ({ kind, label }) because "this person is working on addiction" is itself sensitive.
model Topic {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  encryptedContent String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         TherapySession[]
  programs         SessionProgram[]

  @@index([userId, createdAt])
}

// One completed screening questionnaire. instrument is a coarse public code; answers, total and severity are encrypted.
model Assessment {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  instrument       String // PHQ9 | GAD7 | AUDIT
  encryptedContent String // JSON { answers: number[], total: number, severity: string, item9?: number }
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, instrument, createdAt])
}

model UserConsent {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  consentType    String // AGE_18_PLUS | AI_DISCLOSURE | PRIVACY | JOURNAL_AI_SHARING | WELLNESS_AI_SHARING | HEALTH_IMPORT
  consentVersion String
  grantedAt      DateTime  @default(now())
  withdrawnAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

model UserProfile {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @unique @db.Uuid
  displayName     String
  ageBand         String @default("18_PLUS")
  countryCode     String? @db.VarChar(2)
  preferencesJson Json   @default("{}")
  suggestionLevel String @default("SOMETIMES") // OFTEN | SOMETIMES | RARELY | NEVER: how much Nivora may suggest (action menu, nudges, session invitations)
  analyticsOptIn  Boolean @default(false) // opt-in, anonymous product events about suggestions (no text, no user id)
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TherapySession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  sessionType String    @default("TEXT") // TEXT | VOICE
  language    String    @default("en")
  status      String    @default("ACTIVE") // ACTIVE | ENDED
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  // --- structured guided session fields (all optional / defaulted: older rows stay valid) ---
  lengthMin     Int       @default(0) // 0 = open-ended; else 15 | 30 | 45
  phase         String    @default("OPENING") // OPENING | AGENDA | CORE | SUMMARY | HOMEWORK | CLOSING
  isIntake      Boolean   @default(false)
  rememberThis  Boolean   @default(true) // false = nothing from this session is kept for continuity
  moodBefore    Int? // 1..10 self-reported
  moodAfter     Int?
  riskFlag      String    @default("NONE") // NONE | ELEVATED | HIGH (coarse, never text)
  lastActivityAt DateTime @default(now())
  finalizedAt   DateTime? // set once the summary / session note has been produced
  topicId       String?   @db.Uuid // optional: the topic the user picked before starting
  topic         Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  programId   String?   @db.Uuid // set for a Sitting; null = legacy standalone session
  dayNumber   Int? // 1-based Sitting number inside the program
  plannedMinutes Int    @default(0) // time box for a Sitting; 0 = none
  usedSeconds Int       @default(0) // active seconds spent in a Sitting (see touchSitting); the time box is measured against this, not the wall clock
  program     SessionProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    SessionMessage[]
  note        SessionNote?
  summary     SessionSummary?
  usage       UsageRecord[]

  @@index([userId, startedAt])
  @@index([topicId])
  @@index([programId, startedAt])
}

/// A user-facing "Session": a multi-day program on one topic. Each daily Sitting is a TherapySession row with programId set.
model SessionProgram {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  topicId         String?   @db.Uuid
  titleEncrypted  String
  goalEncrypted   String?
  plannedDays     Int
  dailyMinutes    Int // 30 | 40
  reminderTimeMin Int? // minutes after midnight, local
  status          String    @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | ARCHIVED
  startedAt       DateTime  @default(now())
  lastSittingAt   DateTime?
  completedAt     DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic           Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sittings        TherapySession[]

  @@index([userId, status])
}

model SessionMessage {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @db.Uuid
  role             String // user | assistant
  encryptedContent String
  feedback         Int? // -1 | 1 user feedback on assistant messages
  createdAt        DateTime @default(now())
  session          TherapySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SessionSummary {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @unique @db.Uuid
  encryptedSummary String
  createdAt        DateTime @default(now())
  session          TherapySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model MoodEntry {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  moodScore          Int // 1..5, user reported
  stressScore        Int? // 1..5, user reported
  optionalNoteEncrypted String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model JournalEntry {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  entryType        String    @default("FREE") // FREE | THOUGHT_RECORD | GRATITUDE | DAILY_REFLECTION | SLEEP_STRESS
  encryptedContent String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? // soft delete; purged by retention job (see docs)
  source           String    @default("text") // text | voice
  audioEncrypted   String? // base64 audio, encrypted; only when the user opted in to keep the recording
  audioMime        String?
  emotionEncrypted String? // JSON of the Emotion Reading saved with the entry: words, reflection, the 2-minute step (created only with JOURNAL_AI_SHARING)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TherapyGoal {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  title      String
  status     String    @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED
  targetDate DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns   GoalCheckIn[]

  @@index([userId, status])
}

model GoalCheckIn {
  id                   String   @id @default(uuid()) @db.Uuid
  goalId               String   @db.Uuid
  progressValue        Int // 0..100
  optionalEncryptedNotes String?
  createdAt            DateTime @default(now())
  goal                 TherapyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

model SafetyEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  sessionId   String?  @db.Uuid
  severity    String // NONE | ELEVATED | HIGH | IMMINENT
  category    String? // coarse category only, never message text
  actionTaken String
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model SupportResource {
  id             String   @id @default(uuid()) @db.Uuid
  countryCode    String   @db.VarChar(2)
  language       String
  resourceType   String // EMERGENCY | CRISIS_LINE | TEXT_LINE
  name           String
  contactDetails String
  lastVerifiedAt DateTime? // null = NOT verified; never shown as verified
  sourceUrl      String? // official page the number was checked against
  createdAt      DateTime @default(now())

  @@unique([countryCode, resourceType, name])
  @@index([countryCode])
}

model UsageRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  sessionId    String?  @db.Uuid
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      TherapySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid // no FK: audit rows must survive account deletion
  action       String
  resourceType String
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------- Nivora ----------------

model CheckIn {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  kind          String // MORNING | EVENING
  mood          Int // 1..10 user reported
  stress        Int // 1..10
  energy        Int // 1..10
  sleepQuality  String? // POOR | OKAY | GOOD | GREAT (morning)
  rested        Int? // 1..10 (morning)
  tags          String   @default("") // comma-separated reason tags, e.g. work,family,sleep
  worryEncrypted String? // biggest worry of the day (evening)
  noteEncrypted String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SleepEntry {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  date          String // wake-up date, YYYY-MM-DD
  bedtime       String // HH:mm
  wakeTime      String // HH:mm
  durationMin   Int
  latencyMin    Int
  awakenings    Int
  rested        Int? // 1..10; null for imported nights where the user has not said how rested they felt
  score         Int // 0..100 wellness indicator, not medical
  source        String   @default("manual") // manual | healthconnect | healthkit
  noteEncrypted String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model RoutineLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  date       String // YYYY-MM-DD
  stepsDone  Int
  stepsTotal Int
  doneIds    String   @default("") // comma-separated routine step ids marked done (by the user or by a completed practice)
  extras     Json     @default("[]") // steps added to this night's routine, e.g. from the Sleep Coach: [{ id, minutes }]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model KaizenGoal {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  title           String
  category        String // BREATHING | REFLECTION | JOURNALING | GROUNDING | MEDITATION | SLEEP_ROUTINE | SHORT_WALK | DIGITAL_BREAK | PLANNING | GRATITUDE | SOCIAL | RELAXATION | SELF_OBSERVATION
  targetDirection String?
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  currentTarget   Int      @default(2) // current size of the small step, in `unit`
  systemKey       String? // set for the app's own PAUSED helper goals (one per category per user): practice tools, journal / walk / menu steps. Never for a user's goal.
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions         KaizenAction[]

  @@unique([userId, systemKey])
  @@index([userId, status])
}

model KaizenAction {
  id                String    @id @default(uuid()) @db.Uuid
  goalId            String    @db.Uuid
  userId            String    @db.Uuid
  date              String // YYYY-MM-DD
  title             String
  description       String
  targetValue       Int
  unit              String // minutes | breaths
  difficulty        Int       @default(1) // 1..5
  micro             Boolean   @default(false) // restart / micro action
  status            String    @default("PLANNED") // PLANNED | DONE | PARTIAL | SKIPPED
  difficultyFeedback String? // EASY | OK | HARD | OVERWHELMED
  noteEncrypted     String?
  completedAt       DateTime?
  feltLevel         Int? // 1..5 reflection
  usefulness        Int? // 1..5 reflection
  nextPreference    String? // SAME | EASIER | HARDER
  commentEncrypted  String?
  reflectedAt       DateTime?
  adaptedBy         String? // SLEEP_LOW when today's target was shrunk after a short night (applied once)
  source            String    @default("GOAL") // GOAL | JOURNAL | WALK | MENU | SESSION_CLOSE: where the step came from
  baseTarget        Int? // the step size planned BEFORE a short-night shrink (adaptedBy SLEEP_LOW); the next day is planned from this, so one short night never lowers the goal
  userTextEncrypted String? // the person's own words for the step (e.g. a walk's description), encrypted; `title` then holds a fixed template
  createdAt         DateTime  @default(now())
  goal              KaizenGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, date])
  @@index([userId, date])
}

model Memory {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  encryptedContent String
  source           String   @default("USER") // USER | SESSION
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TrustedContact {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  nameEncrypted  String
  phoneEncrypted String
  relation      String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SafetyPlan {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  encryptedContent String // JSON: warning signs, coping steps, people, reasons to live, safe environment
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgramEnrollment {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  programId     String // e.g. stress-7, anxiety-14, cbti-21
  startedAt     DateTime @default(now())
  completedDays Int[]    @default([])
  status        String   @default("ACTIVE") // ACTIVE | COMPLETED | PAUSED
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
}

/// Curated, original educational passages used for retrieval-augmented answers. Never user data.
model KnowledgeChunk {
  id        String   @id @default(uuid()) @db.Uuid
  source    String // where the idea comes from (name of public guidance), never copied text
  title     String
  language  String   @default("en")
  content   String
  embedding Float[]  @default([])
  createdAt DateTime @default(now())

  @@index([language])
}

/// Privacy-friendly product analytics: no user id, no content. anonId is a daily-rotating salted hash.
model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  day       String
  anonId    String
  propsJson Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([name, day])
}

// ---------------- Guided sessions (Nivora therapy-style continuity) ----------------

/// One structured note per finalized session. encryptedContent = JSON of NoteContent (see services/therapyData.ts).
model SessionNote {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @unique @db.Uuid
  userId           String   @db.Uuid
  encryptedContent String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  session          TherapySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Versioned personal plan. Only the newest active row is used. encryptedContent = JSON of PlanContent.
model TreatmentPlan {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  version          Int
  active           Boolean  @default(true)
  encryptedContent String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId, active])
}

model Homework {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  sessionId         String?   @db.Uuid
  titleEncrypted    String
  dueDate           String? // YYYY-MM-DD
  status            String    @default("ASSIGNED") // ASSIGNED | DONE | SKIPPED
  feedbackEncrypted String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Recurring themes. themeKey = sha256(userId + normalized label) so the label itself is only stored encrypted.
model ThemeTracker {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  themeKey     String
  labelEncrypted String
  count        Int      @default(1)
  lastSeenAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, themeKey])
}

model SessionSchedule {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  weekdays    Int[]   @default([]) // 0 = Sunday
  timeMin     Int     @default(1200) // minutes after midnight, local
  lengthMin   Int     @default(30)
  remindersOn Boolean @default(true)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Optional, separately consented, PII-scrubbed excerpts for quality review. Never created unless the user opted in.
model QualityReviewSample {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  encryptedContent String // scrubbed excerpt, still encrypted at rest
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per user per week: the Kaizen weekly review text (AI-phrased or template) plus its aggregates.
model WeeklySummary {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  weekStart     String // Monday of the week, YYYY-MM-DD (user's local calendar)
  textEncrypted String
  ai            Boolean  @default(false)
  statsJson     Json     @default("{}") // numbers only: done, total, restarts, hardDays
  reportEncrypted String? // the combined "Your week" report: JSON { headline, text, ai } (POST /reports/weekly)
  reportAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

/// Steps / walking / exercise per day, from the device (Health Connect / HealthKit).
model DailyActivity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  date        String // YYYY-MM-DD
  steps       Int?
  walkingMin  Int?
  exerciseMin Int?
  source      String   @default("manual") // manual | healthconnect | healthkit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model NudgeSettings {
  userId       String    @id @db.Uuid
  enabled      Boolean   @default(true)
  quietStart   String    @default("23:00") // HH:mm, user's local time
  quietEnd     String    @default("07:00")
  typesOff     String    @default("") // comma-separated nudge types the user switched off
  snoozedUntil DateTime?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Which nudges were surfaced on which local day (enforces max 2 a day and one per type a day).
model NudgeLog {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  date        String // YYYY-MM-DD local
  type        String // WIND_DOWN | MOOD_CHECKIN | WEEKLY_REVIEW | MORNING_PLAN | SESSION_INVITE
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
}

/// Flowers carried over from deleted goals, so the garden never shrinks. Shown total = completed actions + carried.
model GardenState {
  userId     String   @id @db.Uuid
  carried   Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// What the in-app action menu offered and what the person did with it. Drives the variety filter (last 3 shown, kinds dismissed in 7 days). No text.
model ActionOffer {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  actionId  String // registry id, e.g. BREATHING
  kind      String // registry kind, e.g. BREATHING | JOURNAL | SLEEP
  surface   String // CHAT | CALL | TODAY | INSIGHTS | SESSION_CLOSE | WEEKLY | MONTHLY
  sessionId String?   @db.Uuid
  messageId String?   @db.Uuid
  outcome   String    @default("OFFERED") // OFFERED | ACCEPTED | DISMISSED (an OFFERED row older than an hour counts as ignored)
  feedback  Int? // -1 | 1 thumbs on the card or the message it came with
  createdAt DateTime  @default(now())
  outcomeAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
