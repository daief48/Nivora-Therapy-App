# --- Server ---
NODE_ENV=development
PORT=4010
# Comma-separated allowlist of web origins (native mobile apps send no Origin header)
CORS_ORIGINS=http://localhost:8081

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/nivora

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_ACCESS_SECRET=replace-with-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Encryption at rest: AES-256-GCM keys, 32 bytes base64. Format: id:base64,id:base64 ; first key encrypts, all decrypt (rotation) ---
# generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=k1:replace-with-32-byte-base64-key

# --- OpenAI (used when OPENAI_API_KEY is set; takes precedence over GLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- GLM (fallback provider when no OpenAI key is set; the ONLY paid external credential). Docs: https://docs.z.ai/ ---
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# A model ID enabled for YOUR account (check the z.ai console / docs)
GLM_MODEL=
GLM_TIMEOUT_MS=45000
GLM_MAX_OUTPUT_TOKENS=600

# --- Limits ---
MAX_MESSAGE_CHARS=4000
CONTEXT_MESSAGES=20

# --- Natural voice for voice/video calls (uses OPENAI_API_KEY; falls back to the phone's voice if unavailable) ---
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=shimmer   # soft, light female voice. Also good: coral. Samples: voice-samples/*.mp3
